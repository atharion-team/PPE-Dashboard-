# Save the new content to .gitignore
@'
# --- Training artifacts ---
runs/
datasets/
images/
labels/
*.pt
*.pth
*.onnx
*.engine
*.cache
*.zip
*.tar.gz

# --- App runtime outputs ---
static/uploads/*
static/outputs/*
static/snapshots/*
!static/uploads/.gitkeep
!static/outputs/.gitkeep
!static/snapshots/.gitkeep
uploads/

# --- Demo outputs ---
examples/**/snapshots/
examples/**/events.jsonl
examples/**/compliance_summary.json
examples/offline-dashboard-demo/*.mp4

# --- Keep sample videos in example/ ---
!example/**/*.mp4
!example/**/*.mov
!example/**/*.webm
!example/*.mp4

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
.env
.env.*
.env.local
!.env.example

# --- Editor / OS ---
.vscode/
.idea/
.DS_Store
*.log
'@ | Set-Content .gitignore

git add .gitignore
git commit -m "chore: clean up .gitignore duplicates"
git push origin main